class student{
    private int id;
    private String name;
    public void SetId(int id){
        this.id=id;
    }
    public void SetName (String name){
        this.name=name;
    }
    public int getId(){
        return id;
    }
    public String getName(){
        return name;
    }
}
    public class Main{
        public static void main(String[]args){
            student s=new student();
            s.SetId(101);
            s.SetName("Jayasri");
            System.out.println("Id;"+s.getId());
            System.out.println("Name;"+s.getName());
        }
    }
