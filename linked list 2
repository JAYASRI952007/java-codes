class Node {
    int data;
    Node next;
     Node(int data) {
        this.data = data;
        this.next = null;
    }
}
public class Main {
    static Node head;
static void insertEnd(int data)
{
        Node newNode = new Node(data);
        if (head == null) {
            head = newNode;
            return;
        }
        Node temp = head;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = newNode;
    }
static void insertBeg(int d) {
        Node newNode = new Node(d);
        if (head == null) {
            head = newNode; 
            return;
        }
        newNode.next = head;
        head = newNode;
    }
static void deletefirst() {
        if (head == null) {
            System.out.println("list is empty");
            return;
        }
        head = head.next;
    }
static void deleteend() {
        if (head == null) {
            System.out.println("list is empty");
            return;
        }
        if (head.next == null) {
            head = null;
            return;
        }
        Node temp = head;
        while (temp.next.next != null) {
            temp = temp.next;
        }
        temp.next = null;
    }
static void search(int d) {
        Node temp = head;
        while (temp != null) {
            if (temp.data == d) {
                System.out.println(d + " element found");
                return;
            }
            temp = temp.next;
        }
        System.out.println(d + " element not found");
    }
static void display() {
        Node temp = head;
        while (temp != null) { 
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }
        printlnOutput("null");
    }
    static void printlnOutput(String val) {
        System.out.println(val);
    }
public static void main(String[] args) {
        insertEnd(10);
        insertEnd(20);
        insertEnd(30);
        display();
        System.out.println("insert At beginning");
        insertBeg(50);
        insertBeg(60);
        display();
        System.out.println();
        System.out.println("delete At beginning");
        deletefirst();
        display();
        System.out.println("delete At end");
        deleteend();
        display();
        System.out.println();
        search(20);
    }
}
